{
    "name": "@soundstats/service",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc",
        "dev": "node ../../packages/database/runtime/start.mjs --env dotenv --mode development -- tsx watch src/index.ts",
        "start": "node ../../packages/database/runtime/start.mjs --env dotenv --mode production -- node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@clerk/backend": "2.33.6",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
        "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
        "@opentelemetry/instrumentation-undici": "^0.35.1",
        "@opentelemetry/resources": "^3.1.1",
        "@opentelemetry/sdk-metrics": "^3.1.1",
        "@opentelemetry/sdk-node": "^0.301.2",
        "@opentelemetry/sdk-trace": "^3.1.1",
        "@opentelemetry/semantic-conventions": "^1.45.0",
        "@soundstats/database": "workspace:*",
        "@soundstats/spotify": "workspace:*",
        "cron": "^4.3.3",
        "dotenv": "^17.2.1",
        "drizzle-orm": "0.45.2",
        "postgres": "3.4.7",
        "uploadthing": "^7.7.4",
        "zod": "4.1.5"
    },
    "devDependencies": {
        "tsx": "^4.20.5"
    }
}
